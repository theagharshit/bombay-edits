# PostgreSQL Connection Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/house_of_baneris

# Alternatively use individual connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=house_of_baneris

# App Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================================
# Communications & Notification Service (Email & SMS)
# ===================================================

# 1. Live Email Dispatch (Resend: https://resend.com)
# Leave blank to use dev console logging with in-memory audit trail.
RESEND_API_KEY=
# Use onboarding@resend.dev for instant testing, or your verified domain
EMAIL_FROM="House of Baneri <onboarding@resend.dev>"

# 2. Live SMS Dispatch (Twilio: https://twilio.com)
# Leave blank to use dev console logging with in-memory audit trail.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
